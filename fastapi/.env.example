# 应用配置
APP_ENV=development
APP_NAME=DV-Admin FastAPI
DEBUG=true

# 数据库配置 - 默认为 SQLite，如需使用 MySQL 请取消注释下面一行
DATABASE_URL=sqlite://./dv_admin.db
# DATABASE_URL=mysql://root:password@localhost:3306/dv_admin
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=10

# Redis 配置
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
# 只信任这些代理的 X-Forwarded-For，逗号分隔 IP/CIDR；Uvicorn 禁用 proxy headers
TRUSTED_PROXY_IPS=

# JWT 配置
# 开发环境可留空并使用进程临时密钥；生产环境必须填入随机生成的强密钥。
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 密码配置
PASSWORD_MIN_LENGTH=15
PASSWORD_MAX_LENGTH=128
DEFAULT_PASSWORD=change-me-user-default-password

# 分页配置
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS 配置
ALLOWED_ORIGINS=http://localhost:9527,http://127.0.0.1:9527

# 文件上传配置
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# 缓存配置
CACHE_TTL=300

# OIDC 单点登录（授权码 + PKCE）；启用后生产环境要求 issuer 与回调地址均为 https，配置不完整将拒绝启动
OIDC_ENABLED=false
# 必须与身份提供方 discovery 文档中的 issuer 逐字符一致
OIDC_ISSUER=
OIDC_CLIENT_ID=
# 留空表示公开客户端（令牌端点认证方式 none）
OIDC_CLIENT_SECRET=
# 前端回调页地址，需在身份提供方登记
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# 首次登录自动开通本地账号（默认角色、不可用密码）
OIDC_AUTO_PROVISION=true
# 按已验证邮箱关联已有非超级管理员账号
OIDC_MATCH_EXISTING_BY_EMAIL=false
# 限制自动开通的邮箱域名，逗号或空格分隔；留空不限制
OIDC_ALLOWED_EMAIL_DOMAINS=
