# 生产环境配置文件
# 注意：不要将此文件提交到版本控制系统

# Django 核心配置
DEBUG=True
SECRET_KEY='change-me-use-a-generated-secret-key'  # 请设置一个强密钥
ALLOWED_HOSTS=localhost,127.0.0.1
API_VERSION=v1

# 数据库配置
# PostgreSQL 配置示例
# DATABASE_URL=postgres://username:password@localhost:5432/dbname
# 或者 MySQL 配置示例
# DATABASE_URL=mysql://username:password@localhost:3306/dbname?charset=utf8mb4

# Redis 配置，生产环境请设置密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PWD=
# 只信任这些代理的 X-Forwarded-For，逗号分隔 IP/CIDR；空值忽略转发头
TRUSTED_PROXY_IPS=

# 额外安装的应用，逗号分隔，例如：app1,app2,app3
EXTRA_INSTALLED_APPS=

# CORS 配置，生产环境请使用域名
CORS_ALLOWED_ORIGINS=http://localhost:9527,http://127.0.0.1:9527

# 新增用户默认密码，生产环境请设置一个安全的默认密码
DEFAULT_PWD=change-me-user-default-password

# 上传文件硬上限（字节，默认 10 MiB）
MAX_UPLOAD_SIZE=10485760

# 安全设置，生产环境请全部打开
#SECURE_SSL_REDIRECT=True
#SESSION_COOKIE_SECURE=True
#CSRF_COOKIE_SECURE=True

# JWT配置
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1

# 单点登录（OIDC 授权码 + PKCE），默认关闭；变量名与 FastAPI 一致
# 生产环境（ENVIRONMENT=pro）启用时 issuer 与回调地址必须为 https，配置无效会拒绝启动
OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com/realms/dv-admin
# OIDC_CLIENT_ID=dv-admin
# 留空表示公共客户端（令牌端点认证方式 none）
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://admin.example.com/oidc/callback
# OIDC_SCOPES=openid profile email
# 首次登录自动开通本地账号（不可用密码 + 默认角色）
# OIDC_AUTO_PROVISION=true
# 按已验证邮箱关联已有非超级管理员账号
# OIDC_MATCH_EXISTING_BY_EMAIL=false
# 允许自动开通的邮箱域名，逗号或空格分隔；留空不限制
# OIDC_ALLOWED_EMAIL_DOMAINS=

# 启用 Swagger API 文档（开发环境）
# ENABLE_SWAGGER=True
